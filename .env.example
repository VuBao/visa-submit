# Local access. Keep 127.0.0.1 unless HTTPS is provided by a reverse proxy/VPN.
BW_HTTP_BIND=127.0.0.1
BW_HTTP_PORT=8080
BW_DOMAIN=localhost

# Bitwarden Lite database connection.
BW_DB_PROVIDER=mysql
BW_DB_SERVER=database
BW_DB_DATABASE=bitwarden_vault
BW_DB_USERNAME=bitwarden
BW_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Required. Create these at https://bitwarden.com/host/
BW_INSTALLATION_ID=00000000-0000-0000-0000-000000000000
BW_INSTALLATION_KEY=REPLACE_WITH_INSTALLATION_KEY

# MariaDB initialization. Keep these aligned with the BW_DB_* values above.
MARIADB_DATABASE=bitwarden_vault
MARIADB_USER=bitwarden
MARIADB_PASSWORD=REPLACE_WITH_SAME_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD

# Personal-vault defaults.
BW_ENABLE_SSL=false
BW_ENABLE_ADMIN=true
BW_ENABLE_API=true
BW_ENABLE_EVENTS=false
BW_ENABLE_ICONS=true
BW_ENABLE_IDENTITY=true
BW_ENABLE_NOTIFICATIONS=true
BW_ENABLE_SCIM=false
BW_ENABLE_SSO=false
globalSettings__disableUserRegistration=false

# Optional admin portal access; set your email before exposing the service.
# adminSettings__admins=you@example.com

# Optional SMTP. Needed for email verification and some notifications.
# globalSettings__mail__replyToEmail=vault@example.com
# globalSettings__mail__smtp__host=smtp.example.com
# globalSettings__mail__smtp__port=587
# globalSettings__mail__smtp__ssl=false
# globalSettings__mail__smtp__username=REPLACE
# globalSettings__mail__smtp__password=REPLACE

